{
  "name": "cooking-units",
  "version": "0.1.0",
  "description": "Normalize, convert and sum the units recipes are written in \u2014 el, c\u00e0s and cucharada all mean tbsp. English, Dutch, French, German, Spanish. No runtime dependencies.",
  "keywords": [
    "recipe",
    "cooking",
    "units",
    "measurement",
    "conversion",
    "ingredients",
    "i18n",
    "multilingual",
    "fractions",
    "shopping-list"
  ],
  "license": "MIT",
  "author": "Jeroen Stroobants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stroobaj/cooking-units.git"
  },
  "bugs": {
    "url": "https://github.com/stroobaj/cooking-units/issues"
  },
  "homepage": "https://github.com/stroobaj/cooking-units#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/stamp-dist.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint --strict && attw --pack .",
    "prepublishOnly": "npm run check && npm run test && npm run build && npm run lint:package"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
