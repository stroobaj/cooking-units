{
  "name": "cooking-units",
  "version": "0.1.0",
  "description": "Normalize, convert and sum the units recipes are written in \u2014 el, c\u00e0s and cucharada all mean tbsp. English, Dutch, French, German, Spanish. Zero dependencies.",
  "keywords": [
    "recipe",
    "cooking",
    "units",
    "measurement",
    "conversion",
    "ingredients",
    "i18n",
    "multilingual",
    "fractions",
    "shopping-list"
  ],
  "license": "MIT",
  "author": "Jeroen Stroobants",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stroobaj/cooking-units.git"
  },
  "bugs": {
    "url": "https://github.com/stroobaj/cooking-units/issues"
  },
  "homepage": "https://github.com/stroobaj/cooking-units#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
